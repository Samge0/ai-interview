OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.newcoin.tech
OPENAI_MODEL=doubao-seed-2-0-pro-260215

# AIGC（OpenAI 兼容 POST /v1/images/generations），例如 new.suxi.ai
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://new.suxi.ai
# Gemini 画图模型（如 gemini-2.5-flash-image）走 /v1/chat/completions；DALL·E/Imagen 等走 /v1/images/generations
IMAGE_API_MODEL=gemini-2.5-flash-image

# 访问口令（可选）：设置后用户需要输入正确的口令才能开始访谈，避免公网暴露后被恶意访问
# 留空则不需要口令验证
ACCESS_CODE=
